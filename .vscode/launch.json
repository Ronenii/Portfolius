{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}/backend",
      "envFile": "${workspaceFolder}/backend/.env",
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Frontend: Vite",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 0.0.0.0",
      "cwd": "${workspaceFolder}/frontend",
      "envFile": "${workspaceFolder}/frontend/.env.local"
    },
    {
      "name": "Frontend: Vite (open browser)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev -- --host 0.0.0.0 --open",
      "cwd": "${workspaceFolder}/frontend",
      "envFile": "${workspaceFolder}/frontend/.env.local"
    }
  ],
  "compounds": [
    {
      "name": "Portfolius: Backend + Frontend",
      "configurations": [
        "Backend: FastAPI",
        "Frontend: Vite"
      ],
      "stopAll": true
    },
    {
      "name": "Portfolius: Backend + Frontend (open browser)",
      "configurations": [
        "Backend: FastAPI",
        "Frontend: Vite (open browser)"
      ],
      "stopAll": true
    }
  ]
}
